# Template — copy to ~/.config/systemd/user/ (the human's act; see
# skills/batch/batch.md "The watcher"). Paths come from the environment file,
# never from this unit, so the template carries no workspace path.
[Unit]
Description=PyAuto shift watcher — one tick (deterministic, no LLM)

[Service]
Type=oneshot
# Stop only the tick itself when it exits. The default (control-group) kills
# every process the tick started, and the first `claude --bg` starts the
# background-session daemon inside this unit, so the workers died with the tick
# (pilot live shift 1, 2026-11-06, PyAutoBrain#592). After changing this, copy
# the unit again and run `systemctl --user daemon-reload`.
# Since PyAutoBrain#634 each session is launched in its own transient scope
# (`systemd-run --user --scope`), so the daemon no longer lives in this unit's
# cgroup and systemd stops logging "Found left-over process" each tick. Keep
# KillMode=process anyway: a daemon started before that change, or by a tick
# on a machine without systemd-run, is still spared.
KillMode=process
EnvironmentFile=%h/.config/pyauto/orchestrator.env
# The tick finds the one open brief on PyAutoMind origin/main itself (M3.6a,
# PyAutoBrain#659). PYAUTO_SHIFT_BRIEF in the env file is only an override,
# honoured inside that brief's own window (dispatched -> review-at + 45 min).
ExecStart=/usr/bin/env python3 ${PYAUTO_BRAIN}/bin/orchestrator_watch.py --mind ${PYAUTO_MIND}
